# Copia este archivo como .env.local para desarrollo local.
# En Vercel, pon estas variables en Settings → Environment Variables.

# Cuotas reales para la "Combinada del día" (GRATIS, 500 créditos/mes)
# Regístrate en https://the-odds-api.com
ODDS_API_KEY=tu-key-de-the-odds-api

# Análisis de un partido con IA (GRATIS) → https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-tu-api-key-aqui

# Opcionales
# GEMINI_MODEL=gemini-3.5-flash
# TZ_OFFSET_HOURS=-5
# ODDS_LEAGUES=soccer_epl,soccer_spain_la_liga,soccer_conmebol_copa_libertadores
# ODDS_EXTRA_EVENTS=1   # partidos con córners/tarjetas/ambos marcan (6 créditos c/u; 0 = desactivar)

# Forma real de los equipos (GRATIS) → https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
